# Shopify app credentials (from Shopify Dev Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_customers,write_customers,read_orders,write_app_proxy

# Phase 1 identity (create a long random value in production)
IDENTITY_SESSION_SECRET=
CUSTOMER_ACCOUNT_URL=http://localhost:3000
# Exact production storefront origin allowed to call account JSON APIs.
STOREFRONT_ORIGIN=https://www.fashionpur.com

# Local development only. Never use mock in production.
OTP_PROVIDER=mock
MOCK_OTP_CODE=000000

# Production OTP settings
# OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Phase 2 persistent storage
# Runtime: Supabase transaction-mode pooler (port 6543, pgbouncer=true).
DATABASE_URL=
# Migration-only: Supabase session-mode pooler (port 5432).
DIRECT_URL=
