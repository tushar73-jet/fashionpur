{% comment %}
  The shopper session deliberately lives at the configured account origin, not
  under Shopify App Proxy. That lets the app set a host-only secure cookie.
{% endcomment %}
{{ 'fashionpur-identity.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fashionpur-identity.js' | asset_url }}" defer="defer"></script>
<fashionpur-identity
  data-account-url="{{ block.settings.account_url | escape }}"
  data-return-to="{{ request.path | escape }}"
  {{ block.shopify_attributes }}
>
  <button type="button" class="fashionpur-identity__button" data-identity-login>
    {{ block.settings.button_label | escape }}
  </button>
</fashionpur-identity>

{% schema %}
{
  "name": "Fashionpur Identity",
  "target": "body",
  "settings": [
    { "type": "url", "id": "account_url", "label": "Customer account URL", "info": "Use your dedicated HTTPS account origin, e.g. https://account.fashionpur.com/account/login" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign in" }
  ]
}
{% endschema %}
