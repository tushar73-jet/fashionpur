generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model IdentityCustomer {
  id String @id @default(uuid())
  phone String @unique
  countryCode String?
  dialingCode String?
  locale String?
  name String?
  email String?
  verifiedAt DateTime
  shopifyCustomerId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions IdentitySession[]
  consents MarketingConsent[]
  addresses CustomerAddress[]
  carts CustomerCart[]
  orders CustomerOrder[]
  loginHandoffs IdentityLoginHandoff[]
}

model IdentityLoginHandoff {
  id String @id @default(uuid())
  codeHash String @unique
  returnPath String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  customerId String
  customer IdentityCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId, expiresAt])
  @@index([expiresAt])
}

model IdentitySession {
  id String @id @default(uuid())
  tokenHash String @unique
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  customerId String
  customer IdentityCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId])
  @@index([expiresAt])
}

model OtpChallenge {
  id String @id @default(uuid())
  requestId String @unique
  phone String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([phone, expiresAt])
}

model MarketingConsent {
  id String @id @default(uuid())
  customerId String
  customer IdentityCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel String
  status String
  source String
  policyVersion String
  capturedAt DateTime @default(now())
  withdrawnAt DateTime?
  @@index([customerId, channel, status])
}

model CustomerAddress {
  id String @id @default(uuid())
  customerId String
  customer IdentityCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shopifyAddressId String? @unique
  recipientName String
  phone String?
  address1 String
  address2 String?
  city String
  province String?
  postalCode String
  countryCode String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([customerId])
}

model CustomerCart {
  id String @id @default(uuid())
  customerId String?
  customer IdentityCustomer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shopifyCartToken String @unique
  claimSecretHash String?
  cartUrl String?
  currencyCode String?
  totalAmount Decimal? @db.Decimal(12,2)
  status String @default("active")
  lastActivityAt DateTime @default(now())
  recoveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines CustomerCartLine[]
  @@index([customerId, status])
  @@index([lastActivityAt])
}

model CustomerCartLine {
  id String @id @default(uuid())
  cartId String
  cart CustomerCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  productId String?
  title String
  quantity Int
  unitPrice Decimal? @db.Decimal(12,2)
  imageUrl String?
  updatedAt DateTime @updatedAt
  @@unique([cartId, variantId])
}

model CustomerOrder {
  id String @id @default(uuid())
  customerId String
  customer IdentityCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shopifyOrderId String @unique
  orderName String
  financialStatus String?
  fulfillmentStatus String?
  trackingUrl String?
  totalAmount Decimal? @db.Decimal(12,2)
  currencyCode String?
  orderedAt DateTime
  updatedAt DateTime @updatedAt
  @@index([customerId, orderedAt])
}
